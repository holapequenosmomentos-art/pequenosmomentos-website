---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const inflables = await getCollection("inflables");

const title = "Venta de Inflables | Pequeños Momentos";
const description =
  "Explora nuestro catálogo de inflables a la venta. Castillos, resbaladillas y más para tus eventos.";
---

<Layout title={title} description={description}>
  <main>
    <!-- Hero Section -->
    <section
      class="relative min-h-screen bg-gradient-to-tr from-pink-200 via-purple-100 to-blue-200 overflow-hidden pl-17 lg:pl-0"
    >
      <!-- Decoración de fondo -->
      <div class="absolute inset-0">
        <div
          class="absolute top-20 left-20 w-72 h-72 bg-pink-300/30 rounded-full blur-3xl animate-pulse"
        >
        </div>
        <div
          class="absolute bottom-20 right-20 w-96 h-96 bg-blue-300/30 rounded-full blur-3xl animate-pulse delay-1000"
        >
        </div>
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-white/40 rounded-full blur-2xl"
        >
        </div>
      </div>
      <div
        class="relative z-10 min-h-screen flex items-center justify-center px-4"
      >
        <div class="text-center max-w-4xl mx-auto">
          <div class="inline-block bg-transparent backdrop-blur-sm rounded-2xl">
            <h1 class="text-5xl md:text-7xl font-black text-gray-800">
              Venta de
              <span
                class="bg-gradient-to-r from-pink-400 to-blue-400 bg-clip-text text-transparent"
              >
                Inflables
              </span>
            </h1>
          </div>

          <p class="text-xl md:text-2xl text-gray-700 mb-8 leading-relaxed">
            Inicia o haz crecer tu negocio con nuestros inflables de alta
            calidad. Diseños atractivos, duraderos y seguros para cualquier
            evento.
          </p>

          <div
            class="flex flex-col sm:flex-row gap-4 justify-center items-center"
          >
            <a
              href="#catalogo"
              class="bg-white/80 text-purple-700 px-8 py-4 rounded-2xl font-bold hover:bg-white shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300 active:scale-95"
            >
              Ver Catálogo
            </a>
            <a
              href="https://web.whatsapp.com/send?phone=525539385685"
              target="_blank"
              aria-label="Contactar por WhatsApp"
              class="border-2 border-white/80 bg-white/20 backdrop-blur-sm text-gray-700 px-8 py-4 rounded-2xl font-bold hover:bg-white/30 transform hover:scale-105 hover:shadow-xl transition-all duration-300 active:scale-95"
            >
              Solicitar Cotización
            </a>
          </div>
        </div>
      </div>

      <!-- Indicador de scroll -->
      <div
        class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
      >
        <svg
          class="w-6 h-6 text-gray-600"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </section>
    <div id="catalogo" class="max-w-7xl mx-auto py-16 pl-17 pr-1 md:pr-0 md:pl-0">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          inflables.map((item) => (
            <article class="bg-white rounded-3xl shadow-xl hover:shadow-2xl transition-shadow duration-300 border border-gray-100 flex flex-col overflow-hidden">
              <div class="relative w-full h-64">
                {item.data.imageBanner ? (
                  <img
                    src={item.data.imageBanner}
                    alt={item.data.title}
                    class="absolute inset-0 w-full h-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 w-full h-full bg-pink-100 flex items-center justify-center">
                    <span class="text-4xl">🎈</span>
                  </div>
                )}
              </div>
              
              <div class="p-6 flex flex-col flex-grow">
                <h2 class="text-2xl font-bold text-gray-800 mb-2">
                  {item.data.title}
                </h2>
                <p class="text-gray-600 mb-4 line-clamp-2">
                  {item.data.description}
                </p>

                <!-- Detalles Técnicos -->
                <div class="bg-gray-50 rounded-xl p-4 mb-4 text-sm text-gray-700 space-y-1">
                  {item.data.dimensiones && (
                    <p><strong>Dimensiones:</strong> {item.data.dimensiones}</p>
                  )}
                  {item.data.capacidad && (
                    <p><strong>Capacidad:</strong> {item.data.capacidad}</p>
                  )}
                  {item.data.material && (
                    <p><strong>Material:</strong> {item.data.material}</p>
                  )}
                </div>

                <a
                  href={`/venta-de-inflables/${item.slug}`}
                  class="mt-auto inline-block text-center px-5 py-2 rounded-full bg-gradient-to-r from-pink-400 to-purple-400 text-white font-medium shadow hover:from-pink-500 hover:to-purple-500 transition-colors duration-200"
                >
                  Ver Detalles
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
